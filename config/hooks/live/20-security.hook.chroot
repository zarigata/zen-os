#!/bin/bash
# Security setup hook — UFW, AppArmor, unattended-upgrades
set -e

echo "ZEN-OS: Configuring security..."

# === UFW Firewall ===
# Set default policies
ufw default deny incoming 2>/dev/null || true
ufw default allow outgoing 2>/dev/null || true

# Allow SSH (rate limited — prevents brute force)
ufw limit in ssh/tcp 2>/dev/null || true

# Allow KDE Connect (common use case for gaming desktop)
ufw allow 1714:1764/udp 2>/dev/null || true
ufw allow 1714:1764/tcp 2>/dev/null || true

# Allow Samba (file sharing)
ufw allow samba 2>/dev/null || true

# Enable firewall (must be last — blocks everything not explicitly allowed)
ufw --force enable 2>/dev/null || true

echo "ZEN-OS: UFW firewall configured (deny incoming, allow outgoing)"

# === AppArmor ===
# Already enabled via kernel params (apparmor=1 security=apparmor)
# Ensure profiles are in enforce mode
if command -v aa-enforce &>/dev/null; then
    aa-enforce /etc/apparmor.d/* 2>/dev/null || true
fi

# Cache profiles for faster boot
if command -v aa-cache &>/dev/null; then
    aa-cache --all 2>/dev/null || true
fi

echo "ZEN-OS: AppArmor profiles enforced"

# === Unattended Upgrades ===
# Enable periodic security updates
if [ -f /etc/apt/apt.conf.d/50zenos-unattended-upgrades ]; then
    cat > /etc/apt/apt.conf.d/20auto-upgrades << EOF
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
EOF
fi

echo "ZEN-OS: Unattended security upgrades enabled"

# === SSH hardening ===
# Generate fresh host keys (not the build-time ones)
rm -f /etc/ssh/ssh_host_*_key* 2>/dev/null || true
ssh-keygen -A 2>/dev/null || true

# Disable root password
passwd -l root 2>/dev/null || true

echo "ZEN-OS: Security configuration complete"
