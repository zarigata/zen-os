#!/bin/bash
# Enable ZEN-OS first-boot setup without passwordless sudo exceptions.
set -euo pipefail

mkdir -p /var/lib/zenos
chmod 755 /usr/local/lib/zenos/*.sh 2>/dev/null || true

# Root backend runs once after installation/first boot.
systemctl enable zenos-first-boot.service 2>/dev/null || true

# The graphical welcome is launched by XDG autostart in the user's KDE session.
# Privileged choices are handled through polkit (pkexec), not NOPASSWD sudo.
rm -f /etc/sudoers.d/zenos-first-boot 2>/dev/null || true

echo "ZEN-OS: First-boot setup enabled"
