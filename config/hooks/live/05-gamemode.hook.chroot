#!/bin/bash
# GameMode activates on demand over D-Bus; verify it really ships.
set -euo pipefail

if id live-user >/dev/null 2>&1 && getent group gamemode >/dev/null 2>&1; then
    usermod -aG gamemode live-user
fi

command -v gamemoded >/dev/null 2>&1 || {
    echo "ERROR: gamemoded is missing from the image" >&2
    exit 1
}

echo "ZEN-OS: GameMode verified."
