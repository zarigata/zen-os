# ZEN-OS Plymouth Script
# Minimal boot animation with logo + progress bar

fun progress_update(status, progress) {
    if (status == "boot") {
        progress_bar.Set(progress);
    }
}

# Background
Window.SetBackgroundTopColor(0.09, 0.11, 0.15);
Window.SetBackgroundBottomColor(0.04, 0.16, 0.20);

# Logo
logo.image = Image("background.png");
logo.sprite = Sprite();
logo.sprite.SetImage(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.opacity_angle = 0;

# Progress bar background
progress_box.image = Image.New(600, 8);
progress_box.image.Fill(0.1, 0.2, 0.25, 1);
progress_box.sprite = Sprite();
progress_box.sprite.SetImage(progress_box.image);
progress_box.x = Window.GetX() + Window.GetWidth() / 2 - 300;
progress_box.y = Window.GetY() + Window.GetHeight() * 0.75;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

# Progress bar fill
progress_fill.image = Image.New(1, 8);
progress_fill.image.Fill(0.0, 0.69, 0.69, 1);
progress_fill.sprite = Sprite();
progress_fill.sprite.SetPosition(progress_box.x, progress_box.y, 1);

fun progress_bar(progress) {
    fill_width = progress * 600;
    if (fill_width < 1) fill_width = 1;
    scaled = progress_fill.image.Scale(fill_width, 8);
    progress_fill.sprite.SetImage(scaled);
}

# Animation
fun refresh_callback() {
    logo.opacity_angle += 0.05;
    opacity = 0.7 + 0.3 * Math.Sin(logo.opacity_angle);
    logo.sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_bar);

# Dialog/Prompt
fun message_callback(text) {
    msg.text = text;
}

Plymouth.SetMessageFunction(message_callback);

# Quit
fun quit_callback() {
    logo.sprite.SetOpacity(0);
    progress_fill.sprite.SetOpacity(0);
    progress_box.sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
