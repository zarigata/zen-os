[kcminputrc][Mouse]
cursorSize=24
cursorTheme=breeze_cursors

[kdeglobals][General]
ColorScheme=ZenOS

[kscreenlockerrc][Greeter]
WallpaperPlugin=org.kde.image
token[url]=$(XDG_DATA_DIRS)/wallpapers/zenos/

[ksplashrc][KSplash]
EngineName=KSplashQML
Theme=zenos

[kwinrc][Desktops]
Id_1=1
Id_2=2
Name_1=Desktop
Name_2=Games
Number=2
Rows=1

[kwinrc][Effect-blur]
NoiseStrength=0

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=breeze

[kwinrc][Windows]
BorderSize=Normal

[plasma-desktoptheme]
name=breeze-dark

[plasma-shellrc][Shell]
24hClock=true

[wallpaper]
Image=zenos-default
Plugin=org.kde.image
