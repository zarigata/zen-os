# ZEN-OS Panel Layout — Enhanced for engineering + gaming
# Bottom panel with ZEN-OS tool integration

[Containments][1]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][1][Applets][2]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][1][Applets][2][Configuration]
favorites=zenos-game-hub.desktop,zenos-control-center.desktop,zenos-system-toolkit.desktop,zenos-performance.desktop,zenos-hardware-profiler.desktop,steam.desktop,org.kde.konsole.desktop,org.kde.dolphin.desktop,org.kde.kate.desktop,systemsettings.desktop
showAppsByName=true

[Containments][1][Applets][3]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][1][Applets][3][Configuration]
launchers=zenos-game-hub.desktop,zenos-control-center.desktop,zenos-system-toolkit.desktop,org.kde.konsole.desktop,org.kde.dolphin.desktop
maxStripes=1
showOnlyCurrentActivity=false
showOnlyCurrentDesktop=false

[Containments][1][Applets][4]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][1][Applets][5]
immutability=1
plugin=org.kde.plasma.digitalclock

[Containments][1][Applets][5][Configuration]
customDateFormat=yyyy-MM-dd
displaySeconds=true

[Containments][1][ConfigDialog]
DialogHeight=84
DialogWidth=1920

[Containments][2]
activityId=
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.desktop
wallpaperplugin=org.kde.image

[Containments][2][Wallpaper]
Image=/usr/share/backgrounds/zenos/zenos-default.png
plugin=org.kde.image
