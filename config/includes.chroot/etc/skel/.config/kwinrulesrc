# ZEN-OS KWin Window Rules — Competitive defaults
# These rules improve window management for engineering + gaming

[1]
Description=Remember Steam position
clientmachine=localhost
clientmachinematch=0
position=200,200
wmclass=steam
wmclassmatch=1

[2]
Description=Always maximize Konsole
clientmachine=localhost
clientmachinematch=0
maximizehoriz=true
maximizevert=true
wmclass=konsole
wmclassmatch=1

