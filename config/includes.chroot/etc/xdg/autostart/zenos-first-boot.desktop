[Desktop Entry]
Type=Application
Name=ZEN-OS Welcome
Comment=Finish privacy, app-store and device-integration setup
Exec=/bin/bash /usr/local/lib/zenos/first-boot-gui.sh
Icon=zenos-logo
Categories=System;Settings;
OnlyShowIn=KDE;
NoDisplay=true
X-KDE-autostart-after=panel
X-GNOME-Autostart-enabled=true
