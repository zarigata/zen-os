[Unit]
Description=ZEN-OS First-Boot Security Finalizer
After=multi-user.target
ConditionPathExists=!/var/lib/zenos/.first-boot-backend-done

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/lib/zenos/first-boot.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
