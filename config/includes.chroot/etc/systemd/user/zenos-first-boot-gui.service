[Unit]
Description=ZEN-OS First-Boot Welcome
After=graphical-session.target
Wants=graphical-session.target
ConditionPathExists=!%h/.config/zenos/first-boot-done

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/lib/zenos/first-boot-gui.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
