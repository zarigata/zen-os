# ZEN-OS automatic security updates
# Install Debian security fixes automatically; reboot remains user-controlled.

Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
    "${distro_id} ${distro_codename}-security";
};

# Liquorix is fetched/pinned by the ZEN-OS build and is updated deliberately.
# Debian fallback-kernel security updates are NOT blocked.
Unattended-Upgrade::Package-Blacklist {
    "linux-image-.*-liquorix-.*";
    "linux-headers-.*-liquorix-.*";
    "linux-image-liquorix-.*";
    "linux-headers-liquorix-.*";
};

Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "false";
