# ============================================================
# ZEN-OS — Production .gitignore
# ============================================================

# --- live-build generated (auto-created by lb config/build) ---
config/binary/
config/chroot/
config/bootstrap/
config/common/
config/source/

# --- Build output ---
build/
*.iso
*.img
*.qcow2
*.vmdk
*.raw
*.log
build-*.log
lb.log

# --- live-build runtime ---
.build/
local/
cache/
chroot/
chroot.files
chroot.packages.install
chroot.packages.live

# --- Binary ISO tree (generated by lb build) ---
binary/
binary.modified_timestamps

# --- live-build metadata files (auto-generated) ---
live-image-*.contents
live-image-*.files
live-image-*.packages

# --- Release artifacts ---
*.part*
*.sha256
*.torrent
RELEASE_NOTES_*.md

# --- QEMU / VM testing ---
qemu-storage/
disks/
*.qcow2

# --- NTFS ghost files ---
.ghost-ntfs-*

# --- Test artifacts ---
screenshots/
/tmp-screenshot.png
/final-framebuffer.png
/final-framebuffer2.png
/framebuffer.png
/novnc-interface.png
/novnc-page.png
/vm-test-click.png
/vm-test-screenshot.png
/novnc.log
/qemu-stdout.log
/serial-uefi.log
/boot-direct-legacy.log
/boot-direct-uefi.log
/boot-uefi.log

# --- Large binary packages (downloaded at build time) ---
# Liquorix kernel image is 128MB — exceeds GitHub's 100MB limit
# Downloaded by scripts/fetch-kernel.sh during build
config/packages.chroot/linux-image-7*.deb
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# --- Secrets / Credentials ---
.env
.env.*
*.key
*.pem
*.gpg
!repo/zen-os-archive-keyring.asc

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# --- Docker ---
.docker/

# --- Wallpapers (large PNGs — distribute via Releases) ---
wallpapers/

# --- Empty/placeholder directories ---
mcp/
doc/

# --- Sisyphus (internal AI planning — not for public) ---
.sisyphus/
